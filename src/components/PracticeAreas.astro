---
import { getCollection, render } from "astro:content";

interface Props {
  hideHeader?: boolean;
  glass?: boolean;
  expandable?: boolean;
}
const { hideHeader = false, glass = false, expandable = false } = Astro.props;

const areasRaw = (await getCollection("practiceAreas")).sort(
  (a, b) => a.data.order - b.data.order
);
const areas = await Promise.all(
  areasRaw.map(async (a) => {
    const { Content } = await render(a);
    return { ...a, Content };
  })
);

const icons: Record<string, string> = {
  scales: `<path d="M12 3v18M5 8l-3 5a3 3 0 006 0l-3-5zm14 0l-3 5a3 3 0 006 0l-3-5zM5 8h14M8 21h8" />`,
  gavel: `<path d="M14 4l6 6-3 3-6-6 3-3zM10 8l-7 7 3 3 7-7M14 17l4 4M3 21h12" />`,
  tree: `<path d="M12 22V14M8 14h8l-2-3h1l-3-4h1l-3-4-3 4h1l-3 4h1l-2 3z" />`,
  building: `<path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h.01M15 9h.01M9 13h.01M15 13h.01M9 17h.01M15 17h.01" />`,
  shield: `<path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3zM9 12l2 2 4-4" />`,
  seal: `<path d="M14 3H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V9l-6-6zM14 3v6h6M9 14a3 3 0 106 0 3 3 0 00-6 0zM12 17v3" />`,
  trending: `<path d="M22 7l-8.5 8.5-5-5L2 17M16 7h6v6" />`,
};

const shortDesc: Record<string, string> = {
  "Transactional & M&A Advisory":           "Full-cycle M&A and commercial advisory, from strategic structuring to closing.",
  "Dispute Resolution & Arbitration":        "High-stakes disputes across UAE courts, Free Zones, and international arbitration.",
  "Private Client & Family Office Advisory": "Succession, governance, and legacy counsel for families and family offices.",
  "Real Estate & Investment Structuring":    "Acquisitions, disposals, and developer advisory in Abu Dhabi's property market.",
  "Regulatory & Compliance":                 "Translating complex regulatory regimes into clear, workable internal governance.",
  "Notary Services":                         "Precise, discreet notarial services for corporate and personal instruments.",
  "Venture & Growth Advisory":               "Legal infrastructure for founders, from first incorporation through fundraising rounds to exit.",
};

const serviceTags: Record<string, string[]> = {
  "Transactional & M&A Advisory":           ["M&A", "Commercial", "Incorporation"],
  "Dispute Resolution & Arbitration":        ["Litigation", "Arbitration", "ADR"],
  "Private Client & Family Office Advisory": ["Succession", "Family Offices", "Trusts"],
  "Real Estate & Investment Structuring":    ["Real Estate", "Construction", "Infrastructure"],
  "Regulatory & Compliance":                 ["AML", "Governance", "Employment"],
  "Notary Services":                         ["Corporate Docs", "Attestation", "Sensitive Matters"],
  "Venture & Growth Advisory":               ["Fundraising", "Founder Advisory", "Exits & Acquisitions"],
};

// Theme-dependent classes
const sectionCls = glass
  ? "relative text-white overflow-hidden"
  : "relative bg-cream text-navy-900 overflow-hidden";
const eyebrowCls = glass ? "text-gold-300" : "text-gold-600";
const headingCls = glass ? "text-white" : "text-navy-900";
const headingAccent = glass ? "text-gold-300" : "text-gold-500";
const introCls = glass ? "text-white/70" : "text-navy-600";
const gridGapCls = glass ? "gap-6" : "gap-px";
const cardCls = glass
  ? "bg-navy-950/45 backdrop-blur-sm border border-white/10 group hover:bg-navy-900/80 hover:border-gold-400/40 transition-colors duration-500 p-8 lg:p-10 flex flex-col gap-5 relative overflow-hidden"
  : "bg-cream group hover:bg-navy-900 transition-colors duration-500 p-8 lg:p-10 flex flex-col gap-5 relative overflow-hidden";
const numCls = glass
  ? "absolute top-3 right-5 font-serif text-[5rem] leading-none select-none text-white/[0.10] group-hover:text-white/[0.16] transition-colors"
  : "absolute top-3 right-5 font-serif text-[5rem] leading-none select-none text-navy-900/[0.15] group-hover:text-white/[0.12] transition-colors";
const iconCls = glass
  ? "w-10 h-10 border border-gold-300/40 text-gold-300 flex items-center justify-center group-hover:border-gold-200/60 group-hover:text-gold-200 transition-colors flex-shrink-0"
  : "w-10 h-10 border border-gold-500/40 text-gold-500 flex items-center justify-center group-hover:border-gold-300/60 group-hover:text-gold-300 transition-colors flex-shrink-0";
const titleCls = glass
  ? "font-serif text-xl lg:text-[1.4rem] text-white leading-snug transition-colors"
  : "font-serif text-xl lg:text-[1.4rem] text-navy-900 group-hover:text-white leading-snug transition-colors";
const descCls = glass
  ? "text-white/60 text-sm leading-relaxed flex-1 transition-colors"
  : "text-navy-600 group-hover:text-white/60 text-sm leading-relaxed flex-1 transition-colors";
const tagCls = glass
  ? "text-[9px] tracking-[0.15em] uppercase border border-gold-300/30 text-gold-300/70 px-2.5 py-1 transition-colors"
  : "text-[9px] tracking-[0.15em] uppercase border border-gold-500/30 text-gold-600/70 group-hover:border-gold-300/40 group-hover:text-gold-300/70 px-2.5 py-1 transition-colors";
const ctaCls = glass
  ? "inline-flex items-center gap-1.5 text-[10px] tracking-[0.18em] uppercase font-medium text-gold-300 border-b border-gold-400/40 hover:border-gold-200 pb-0.5 transition-colors self-start mt-1"
  : "inline-flex items-center gap-1.5 text-[10px] tracking-[0.18em] uppercase font-medium text-navy-500 group-hover:text-gold-300 border-b border-navy-300/60 group-hover:border-gold-400/50 pb-0.5 transition-colors self-start mt-1";
---

<section id="practice" class={sectionCls}>

  <!-- ░░ Section header ░░ -->
  {!hideHeader && (
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pt-24 pb-16 lg:pb-20">
      <p class={`text-sm tracking-[0.25em] uppercase mb-4 ${eyebrowCls}`}>Practice Areas</p>
      <h2 class={`text-4xl md:text-5xl lg:text-6xl font-serif leading-[1.1] ${headingCls}`}>
        Where law meets<br />
        <span class={`italic ${headingAccent}`}>leadership.</span>
      </h2>
      <span class="gold-divider"></span>
      <p class={`text-base max-w-sm leading-relaxed ${introCls}`}>
        A focused suite of services, each led by senior counsel with the depth and judgment your matter demands.
      </p>
    </div>
  )}

  <!-- ░░ Card grid ░░ -->
  <div class:list={["relative z-10 max-w-7xl mx-auto px-6 lg:px-10 pb-24 lg:pb-32", { "pt-24": hideHeader }]}>
    <div class:list={["grid md:grid-cols-2 lg:grid-cols-3", gridGapCls]}>
      {areas.map((area) => {
        const desc = shortDesc[area.data.title] ?? area.data.summary;
        const tags = serviceTags[area.data.title] ?? [];
        return (
          <div class:list={[cardCls, expandable ? "cursor-pointer" : "cursor-default"]}>

            {/* Decorative number */}
            <span class={numCls}>
              {String(area.data.order).padStart(2, "0")}
            </span>

            {/* Icon */}
            <div class={iconCls}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[area.data.icon] ?? icons.scales}></svg>
            </div>

            {/* Title */}
            <h3 class={titleCls}>{area.data.title}</h3>

            {/* Description */}
            <p class={descCls}>{desc}</p>

            {/* Tags */}
            <div class="flex flex-wrap gap-1.5">
              {tags.map(tag => (
                <span class={tagCls}>{tag}</span>
              ))}
            </div>

            {expandable ? (
              <Fragment>
                {/* Hover affordance — compact badge, bottom-right corner */}
                <div class="absolute bottom-0 right-0 p-3 flex justify-end pointer-events-none">
                  <span class="translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 inline-flex items-center gap-1.5 text-gold-200 text-[8px] tracking-[0.18em] uppercase border border-gold-300/50 px-2 py-1 bg-navy-950/70 backdrop-blur-sm">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1018 0 9 9 0 00-18 0z"/><path d="M8 12h8M12 8v8"/></svg>
                    View full description
                  </span>
                </div>
                {/* Click target covering the whole card */}
                <button
                  type="button"
                  class="practice-trigger absolute inset-0 z-20"
                  data-modal={`practice-modal-${area.data.order}`}
                  aria-label={`View full description of ${area.data.title}`}
                ></button>
              </Fragment>
            ) : (
              <a href="/contact" class={ctaCls}>
                Discuss <span aria-hidden="true">→</span>
              </a>
            )}

          </div>
        );
      })}
    </div>
  </div>

  {expandable && areas.map((area) => (
    <div
      id={`practice-modal-${area.data.order}`}
      class="practice-modal fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
      role="dialog"
      aria-modal="true"
      aria-label={area.data.title}
    >
      <div class="modal-backdrop absolute inset-0 bg-navy-950/85 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
      <div class="modal-scene relative w-full max-w-2xl">
        <div class="modal-card relative bg-navy-800 border border-gold-400/30 shadow-2xl shadow-navy-950/60 max-h-[88vh] overflow-y-auto">
          <button
            type="button"
            class="modal-close absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center text-white/80 hover:text-white bg-navy-950/60 hover:bg-navy-950 border border-white/15 hover:border-gold-400 transition-colors"
            aria-label="Close"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
          <div class="p-8 lg:p-12">
            <div class="w-11 h-11 border border-gold-400/40 text-gold-300 flex items-center justify-center mb-6">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[area.data.icon] ?? icons.scales}></svg>
            </div>
            <p class="text-gold-300 text-[11px] tracking-[0.25em] uppercase mb-3">Practice Area</p>
            <h3 class="font-serif text-2xl lg:text-3xl text-white leading-tight">{area.data.title}</h3>
            <span class="gold-divider"></span>
            <div class="practice-prose text-white/75 text-sm leading-relaxed">
              <area.Content />
            </div>
            <a href="/contact" class="mt-8 inline-flex items-center gap-2 text-gold-300 hover:text-white border-b border-gold-400/50 hover:border-white pb-1 text-xs tracking-[0.18em] uppercase transition-colors">
              Discuss this matter <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  ))}

</section>

{expandable && (
  <Fragment>
    <style is:global>
      .practice-modal.is-open { display: flex; }
      .practice-modal.is-open .modal-backdrop { opacity: 1; }
      .practice-modal .modal-scene { perspective: 1800px; }
      .practice-modal .modal-card {
        transform-origin: center center;
        transform: rotateY(-90deg) scale(0.85);
        opacity: 0;
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.45s ease-out;
      }
      .practice-modal.is-shown .modal-card { transform: rotateY(0deg) scale(1); opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        .practice-modal .modal-card { transition: opacity 0.25s ease-out; transform: none; }
      }
      .practice-prose p { margin: 0 0 1rem; }
      .practice-prose strong {
        display: block; margin-top: 1.5rem; margin-bottom: 0.6rem;
        color: #fff; font-weight: 600; font-size: 0.7rem;
        letter-spacing: 0.2em; text-transform: uppercase;
      }
      .practice-prose ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
      .practice-prose li { position: relative; padding-left: 1.1rem; color: rgba(255,255,255,0.72); }
      .practice-prose li::before {
        content: ""; position: absolute; left: 0; top: 0.5em;
        width: 5px; height: 5px; background: #b9916d; transform: rotate(45deg);
      }
    </style>

    <script is:inline>
      (function () {
        const openModal = (modal) => {
          modal.classList.add("is-open");
          document.body.style.overflow = "hidden";
          requestAnimationFrame(() => requestAnimationFrame(() => modal.classList.add("is-shown")));
        };
        const closeModal = (modal) => {
          modal.classList.remove("is-shown");
          document.body.style.overflow = "";
          const card = modal.querySelector(".modal-card");
          const done = () => { modal.classList.remove("is-open"); card && card.removeEventListener("transitionend", done); };
          if (card) card.addEventListener("transitionend", done);
          else modal.classList.remove("is-open");
          setTimeout(() => modal.classList.remove("is-open"), 700);
        };
        document.querySelectorAll(".practice-trigger").forEach((btn) => {
          btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-modal");
            const modal = id && document.getElementById(id);
            if (modal) openModal(modal);
          });
        });
        document.querySelectorAll(".practice-modal").forEach((modal) => {
          const backdrop = modal.querySelector(".modal-backdrop");
          const closeBtn = modal.querySelector(".modal-close");
          backdrop && backdrop.addEventListener("click", () => closeModal(modal));
          closeBtn && closeBtn.addEventListener("click", () => closeModal(modal));
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            const open = document.querySelector(".practice-modal.is-open");
            if (open) closeModal(open);
          }
        });
      })();
    </script>
  </Fragment>
)}
