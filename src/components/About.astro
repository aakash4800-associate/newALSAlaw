---
interface Props {
  hideHeader?: boolean;
  tone?: "white" | "cream" | "glass";
  showPhoto?: boolean;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
}
const {
  hideHeader = false,
  tone = "white",
  showPhoto = true,
  image = "/abu-dhabi.jpg",
  imageAlt = "Abu Dhabi skyline",
  imagePosition = "object-left",
} = Astro.props;
const onDark = tone === "glass";
const sectionBg = tone === "glass" ? "bg-transparent" : tone === "cream" ? "bg-cream" : "bg-white";
const statTitle = onDark ? "text-white" : "text-navy-900";
const statSub = onDark ? "text-white/70" : "text-navy-600";
---
<section id="about" class:list={["py-24 md:py-32", sectionBg]}>
  <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-12 gap-12 lg:gap-20 items-center">

    <!-- ░░ Left panel: Abu Dhabi skyline photo with warm gold duotone ░░ -->
    <div class="lg:col-span-5 order-2 lg:order-1">
      <div class="relative">
        <!-- corner accents -->
        <div class="absolute -top-4 -left-4 w-24 h-24 border-2 border-gold-400 z-10 pointer-events-none"></div>
        <div class="absolute -bottom-4 -right-4 w-24 h-24 border-2 border-gold-400 z-10 pointer-events-none"></div>

        {showPhoto ? (
          <div class="relative overflow-hidden" style="aspect-ratio: 4/5;">
            <!-- Feature photo -->
            <img
              src={image}
              alt={imageAlt}
              class:list={["w-full h-full object-cover", imagePosition]}
              loading="lazy"
            />
            <!-- Light overlay — same treatment as the London banner -->
            <div class="absolute inset-0 bg-navy-950/45"></div>
            <!-- Extra darken at bottom for quote readability -->
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
            <!-- Thin gold diagonal accent -->
            <svg class="absolute inset-0 w-full h-full pointer-events-none" preserveAspectRatio="none">
              <line x1="0" y1="0" x2="100%" y2="100%" stroke="rgba(185,145,109,0.3)" stroke-width="1"/>
            </svg>
            <!-- Quote overlay -->
            <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-10">
              <blockquote class="font-serif text-white text-lg lg:text-xl leading-snug">
                "We do not compete on volume. We are retained for judgment, and trusted with what follows."
              </blockquote>
              <div class="mt-5 pt-4 border-t border-white/20">
                <div class="text-white/90 text-sm font-medium">Satinder Hunjan KC</div>
                <div class="text-white/55 text-xs tracking-wide mt-0.5">Co-Founder and Chairman</div>
              </div>
            </div>
          </div>
        ) : (
          <!-- Quote panel (no photo) — translucent navy with gold accent -->
          <div class="relative overflow-hidden flex items-end" style="aspect-ratio: 4/5;">
            <div class="absolute inset-0 bg-navy-950/40 backdrop-blur-sm"></div>
            <div class="absolute inset-0" style="background: radial-gradient(ellipse 75% 60% at 30% 18%, rgba(185,145,109,0.16) 0%, transparent 65%);"></div>
            <svg class="absolute top-7 left-7 text-gold-400/70" width="52" height="42" viewBox="0 0 36 28" fill="currentColor" aria-hidden="true"><path d="M0 28V16C0 7 5 1 14 0v6C9 7 6 11 6 16h8v12H0zm22 0V16C22 7 27 1 36 0v6c-5 1-8 5-8 10h8v12H22z"/></svg>
            <div class="relative p-8 lg:p-10">
              <blockquote class="font-serif text-white text-xl lg:text-2xl leading-snug">
                "We do not compete on volume. We are retained for judgment, and trusted with what follows."
              </blockquote>
              <div class="mt-5 pt-4 border-t border-white/20">
                <div class="text-white/90 text-sm font-medium">Satinder Hunjan KC</div>
                <div class="text-white/55 text-xs tracking-wide mt-0.5">Co-Founder and Chairman</div>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- ░░ Right: text content ░░ -->
    <div class="lg:col-span-7 order-1 lg:order-2">
      {!hideHeader && (
        <Fragment>
          <p class="text-gold-600 text-sm tracking-[0.25em] uppercase mb-4">About the Firm</p>
          <h2 class="text-4xl md:text-5xl font-serif text-navy-900 leading-tight">
            Senior attention.<br />
            <span class="italic text-gold-600">Without exception.</span>
          </h2>
          <span class="gold-divider"></span>
          <p class="text-navy-700 text-lg leading-relaxed mb-8">
            A senior-counsel boutique with a presence in Abu Dhabi and London, founded by practitioners from the highest levels of the Bar and government. Our clients trust us with their most consequential decisions and we bring the full weight of our experience to each one.
          </p>
        </Fragment>
      )}
      <div class="grid grid-cols-2 gap-6 max-w-lg">
        <div class="border-l-2 border-gold-400 pl-4">
          <div class={`font-serif text-2xl ${statTitle}`}>60+ Years</div>
          <div class={`text-sm mt-1 ${statSub}`}>Combined Experience</div>
        </div>
        <div class="border-l-2 border-gold-400 pl-4">
          <div class={`font-serif text-2xl ${statTitle}`}>40+</div>
          <div class={`text-sm mt-1 ${statSub}`}>Government &amp; Institutional Entities Advised</div>
        </div>
        <div class="border-l-2 border-gold-400 pl-4">
          <div class={`font-serif text-2xl ${statTitle}`}>Abu Dhabi · London</div>
          <div class={`text-sm mt-1 ${statSub}`}>Our Presence</div>
        </div>
      </div>

    </div>

  </div>
</section>
