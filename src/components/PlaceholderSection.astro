---
interface Block {
  title: string;
  note: string;
}
interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  blocks: Block[];
  dark?: boolean;
  glass?: boolean;
}
const { eyebrow, heading, intro, blocks, dark = false, glass = false } = Astro.props;

const onDark = dark || glass;
const sectionBg = glass ? "bg-transparent text-white" : dark ? "bg-navy-900 text-white" : "bg-cream text-navy-900";
const cardBg = glass
  ? "border-white/10 bg-navy-950/40 backdrop-blur-sm"
  : dark
    ? "border-white/10 bg-navy-950/40"
    : "border-navy-900/10 bg-white";
---
<section class={`py-20 md:py-28 ${sectionBg}`}>
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <p class={`text-sm tracking-[0.25em] uppercase mb-4 ${onDark ? "text-gold-300" : "text-gold-600"}`}>{eyebrow}</p>
    <h2 class={`text-3xl md:text-4xl font-serif leading-tight ${onDark ? "text-white" : "text-navy-900"}`}>{heading}</h2>
    <span class="gold-divider"></span>
    {intro && (
      <p class={`text-base md:text-lg leading-relaxed max-w-2xl mb-12 ${onDark ? "text-white/70" : "text-navy-600"}`}>{intro}</p>
    )}
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {blocks.map((b) => (
        <div class={`border p-6 lg:p-8 ${cardBg}`}>
          <div class="text-[10px] tracking-[0.25em] uppercase text-gold-500 mb-3">Placeholder</div>
          <h3 class={`font-serif text-lg mb-2 ${onDark ? "text-white" : "text-navy-900"}`}>{b.title}</h3>
          <p class={`text-sm leading-relaxed ${onDark ? "text-white/60" : "text-navy-600"}`}>{b.note}</p>
        </div>
      ))}
    </div>
  </div>
</section>
