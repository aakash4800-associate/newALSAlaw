---
import Layout from "../layouts/Layout.astro";
import Testimonials from "../components/Testimonials.astro";
import PageHeader from "../components/PageHeader.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---
<Layout title="What the Directories Say — ALSA Law" description="Recognition and testimonials for ALSA Law from leading legal directories.">
  <PageHeader
    eyebrow="What the Directories Say"
    title="Recognised by those who matter."
    subtitle="Rankings, awards, and the words of clients and referring counsel who have worked with the firm."
    image="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1920&q=80"
    position="object-center"
  />
  <Testimonials hideHeader />
  <!-- ░░ Rankings & awards ░░ -->
  <section class="py-20 md:py-28 bg-cream text-navy-900">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <p class="text-gold-600 text-sm tracking-[0.25em] uppercase mb-4">Recognition</p>
      <h2 class="text-3xl md:text-4xl font-serif leading-tight text-navy-900">Rankings & awards.</h2>
      <span class="gold-divider"></span>
      <div class="flex items-baseline gap-3 mb-12">
        <span class="font-serif text-xl text-navy-900">Satinder Hunjan KC</span>
        <span class="text-xs tracking-[0.2em] uppercase text-navy-500">Co-Founder and Chairman</span>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { label: "Judicial Appointment · 2008", title: "Deputy High Court Judge", note: "Appointed to sit as a Deputy High Court Judge." },
          { label: "The Legal 500", title: "Leading Silk", note: "Recognised as a leading silk for personal injury and for clinical negligence." },
          { label: "Accreditation", title: "CEDR Accredited", note: "Centre for Effective Dispute Resolution." },
          { label: "Finance Monthly Magazine · 2016", title: "Sports Barrister of the Year", note: "" },
          { label: "Lawyer Monthly Magazine · 2015", title: "Clinical Negligence Barrister of the Year", note: "" },
        ].map((a) => (
          <div class="border border-navy-900/10 bg-white p-6 lg:p-8 flex flex-col">
            <svg class="text-gold-500 mb-4" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 13.9L7 22l5-3 5 3-1.5-8.1"/></svg>
            <div class="text-[10px] tracking-[0.22em] uppercase text-gold-600 mb-2">{a.label}</div>
            <h3 class="font-serif text-xl text-navy-900 leading-snug">{a.title}</h3>
            {a.note && <p class="text-sm text-navy-600 leading-relaxed mt-2">{a.note}</p>}
          </div>
        ))}
      </div>
    </div>
  </section>
  <PlaceholderSection
    dark
    eyebrow="Client Voices"
    heading="In their own words."
    intro="[Placeholder] Extended client testimonials and case-outcome highlights."
    blocks={[
      { title: "Full Testimonials", note: "[Placeholder] Longer-form quotes from clients and referring counsel." },
      { title: "Notable Outcomes", note: "[Placeholder] Results achieved on landmark matters." },
      { title: "Client Sectors", note: "[Placeholder] The range of clients the firm has served." },
    ]}
  />
</Layout>
