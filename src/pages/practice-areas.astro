---
import Layout from "../layouts/Layout.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
---
<Layout title="Practice Areas — ALSA Law" description="A focused suite of legal services, each led by senior counsel with the depth and judgment your matter demands.">
  <!-- ░░ Fixed London backdrop — content scrolls over it ░░ -->
  <div class="fixed inset-0" style="z-index: -10;" aria-hidden="true">
    <img src="/london-westminster.jpg" alt="" class="w-full h-full object-cover object-center" />
    <!-- Wash to settle the bright city lights behind the text -->
    <div class="absolute inset-0 bg-navy-950/52"></div>
    <!-- Gradient: darker top (pale sky behind nav + heading) and bottom (bright river), lighter middle -->
    <div class="absolute inset-0 bg-gradient-to-b from-navy-950/80 via-navy-950/25 to-navy-950/60"></div>
    <!-- Subtle warm glow -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 70% at 20% 30%, rgba(185,145,109,0.10) 0%, transparent 65%);"></div>
  </div>

  <!-- Content sits over the fixed backdrop; sections are transparent -->
  <div class="relative text-white pt-20 md:pt-24">
    <PracticeAreas glass expandable />
    <!-- ░░ Our Approach — how we handle a matter ░░ -->
    <section class="py-20 md:py-28">
      <div class="max-w-7xl mx-auto px-6 lg:px-10">
        <p class="text-gold-300 text-sm tracking-[0.25em] uppercase mb-4">Our Approach</p>
        <h2 class="text-3xl md:text-4xl font-serif leading-tight text-white">How we handle a matter.</h2>
        <span class="gold-divider"></span>
        <p class="text-white/70 text-base md:text-lg leading-relaxed max-w-2xl mb-12">
          Every engagement follows the same discipline, whatever the matter. From the first conversation to its resolution, you deal with senior counsel and you always know where you stand.
        </p>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="border border-white/10 bg-navy-950/40 backdrop-blur-sm p-6 lg:p-8">
            <div class="font-serif text-2xl text-gold-400 mb-3">01</div>
            <h3 class="font-serif text-lg text-white mb-2">The first conversation</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              We begin by understanding what you are actually trying to achieve. You receive a candid, confidential read on your position and your options before any engagement is agreed.
            </p>
          </div>
          <div class="border border-white/10 bg-navy-950/40 backdrop-blur-sm p-6 lg:p-8">
            <div class="font-serif text-2xl text-gold-400 mb-3">02</div>
            <h3 class="font-serif text-lg text-white mb-2">Strategy and scope</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              We set a clear plan, a defined scope, and name the senior lawyer who will own your matter. No ambiguity about what we are doing or who is doing it.
            </p>
          </div>
          <div class="border border-white/10 bg-navy-950/40 backdrop-blur-sm p-6 lg:p-8">
            <div class="font-serif text-2xl text-gold-400 mb-3">03</div>
            <h3 class="font-serif text-lg text-white mb-2">Senior-led execution</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              The partner you met leads the matter. You are kept informed as it develops, with proactive communication and no surprises along the way.
            </p>
          </div>
          <div class="border border-white/10 bg-navy-950/40 backdrop-blur-sm p-6 lg:p-8">
            <div class="font-serif text-2xl text-gold-400 mb-3">04</div>
            <h3 class="font-serif text-lg text-white mb-2">Resolution, and beyond</h3>
            <p class="text-sm text-white/60 leading-relaxed">
              We see the matter through to its conclusion, and remain available for what comes next. The best measure of our work is the client who returns.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
