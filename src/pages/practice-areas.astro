---
import Layout from "../layouts/Layout.astro";
import PracticeAreas from "../components/PracticeAreas.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---
<Layout title="Practice Areas — ALSA Law" description="A focused suite of legal services, each led by senior counsel with the depth and judgment your matter demands.">
  <!-- ░░ Fixed London backdrop — content scrolls over it ░░ -->
  <div class="fixed inset-0" style="z-index: -10;" aria-hidden="true">
    <img src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?auto=format&fit=crop&w=1920&q=80" alt="" class="w-full h-full object-cover object-center" />
    <!-- Dark wash for cohesion + legibility -->
    <div class="absolute inset-0 bg-navy-950/65"></div>
    <!-- Subtle warm glow -->
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 70% at 20% 30%, rgba(185,145,109,0.10) 0%, transparent 65%);"></div>
  </div>

  <!-- Content sits over the fixed backdrop; sections are transparent -->
  <div class="relative text-white pt-20 md:pt-24">
    <PracticeAreas glass expandable />
    <PlaceholderSection
      glass
      eyebrow="In Depth"
      heading="Beyond the overview."
      intro="[Placeholder] Detailed breakdown of each practice area — scope of work, typical engagements, and the senior counsel who lead them."
      blocks={[
        { title: "Detailed Service Scope", note: "[Placeholder] A full description of what each practice area covers and who it serves." },
        { title: "Representative Matters", note: "[Placeholder] Anonymised case studies and examples of work delivered." },
        { title: "Sectors We Serve", note: "[Placeholder] Industries and client types the firm advises across." },
      ]}
    />
    <PlaceholderSection
      glass
      eyebrow="Our Approach"
      heading="How we handle a matter."
      intro="[Placeholder] The firm's methodology — from first consultation through resolution."
      blocks={[
        { title: "Process", note: "[Placeholder] Step-by-step of how an engagement typically unfolds." },
        { title: "Fees & Structure", note: "[Placeholder] How the firm approaches pricing and engagement terms." },
        { title: "Why ALSA Law", note: "[Placeholder] What distinguishes the firm's handling of complex matters." },
      ]}
    />
  </div>
</Layout>
