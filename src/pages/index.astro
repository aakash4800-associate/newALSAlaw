---
import Layout from "../layouts/Layout.astro";
import Landing from "../components/Landing.astro";
import Hero from "../components/Hero.astro";
---
<Layout>
  <Landing />
  <Hero />
</Layout>

<style is:global>
  /* Scroll-reveal base state (only applied once JS confirms motion is allowed) */
  .motion-ready [data-reveal] {
    opacity: 0;
    transform: translateY(36px);
    filter: blur(6px);
    transition:
      opacity 1s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 1s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .motion-ready [data-reveal].is-revealed {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .motion-ready [data-reveal-line] {
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  .motion-ready [data-reveal-line].is-revealed { transform: scaleX(1); }
</style>

<script is:inline>
  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;
    document.documentElement.classList.add("motion-ready");

    // ── Staggered reveals as elements enter the viewport ──
    var revealEls = document.querySelectorAll("[data-reveal], [data-reveal-line]");
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          e.target.classList.add("is-revealed");
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -8% 0px" });
    revealEls.forEach(function (el) { io.observe(el); });

    // ── Scroll-linked motion (parallax, scale, fade) ──
    var stack = document.getElementById("landing-stack");
    var cue = document.getElementById("landing-cue");
    var orbs = document.querySelectorAll("[data-orb]");
    var heroSection = document.getElementById("hero");
    var heroMedia = document.getElementById("hero-media");
    var heroText = document.getElementById("hero-text");
    var logoA = document.getElementById("logo-a");   // upright A
    var logoV = document.getElementById("logo-v");   // inverted A
    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

    var ticking = false;
    function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

    function update() {
      var vh = window.innerHeight;
      var y = window.scrollY;

      // Landing: brand stack recedes (lifts, shrinks, fades) as you leave it
      var p = clamp(y / vh, 0, 1);
      if (stack) {
        stack.style.transform = "translate3d(0," + (-p * 140) + "px,0) scale(" + (1 - p * 0.22) + ")";
        stack.style.opacity = String(clamp(1 - p * 1.3, 0, 1));
      }
      if (cue) cue.style.opacity = String(clamp(1 - p * 3, 0, 1));

      // Logo: the upright A rises and the inverted A sinks, so the mark opens into a clean diamond.
      // Vertical is the only direction that pulls their parallel strokes apart instead of together.
      // Subtle, eased, and fully reversible when scrolling back up.
      var s = easeOutCubic(clamp((p - 0.02) / 0.7, 0, 1));
      if (logoA) logoA.style.transform = "translate3d(0," + (-16 * s) + "%,0)";
      if (logoV) logoV.style.transform = "translate3d(0," + (16 * s) + "%,0)";
      orbs.forEach(function (o, i) {
        var speed = i % 2 === 0 ? 0.35 : -0.25;
        o.style.translate = "0 " + (y * speed) + "px";
      });

      // Hero: photo zooms from 1.18 → 1 as the section scrolls in; text drifts up
      if (heroSection) {
        var r = heroSection.getBoundingClientRect();
        var q = clamp(1 - r.top / vh, 0, 1); // 0 when hero top at viewport bottom, 1 when at top
        if (heroMedia) {
          heroMedia.style.transform = "scale(" + (1.18 - q * 0.18) + ") translate3d(0," + ((1 - q) * 40) + "px,0)";
        }
        if (heroText) {
          heroText.style.transform = "translate3d(0," + ((1 - q) * 60) + "px,0)";
        }
      }
      ticking = false;
    }

    window.addEventListener("scroll", function () {
      if (!ticking) { requestAnimationFrame(update); ticking = true; }
    }, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();
</script>
